generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  email            String?   @unique
  password         String?
  discordId        String?   @unique
  createdVia       String    @default("site")
  avatar           String?
  bio              String?
  dateOfBirth      DateTime?
  role             Role      @default(USER)   // permission level only — USER/ADMIN/SPONSOR/FOUNDING_WRITER. Event/challenge rewards are UserBadge rows now, never written here.
  createdAt        DateTime  @default(now())
  timezone         String    @default("UTC")
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?

  referralSource   String?   // "how did you find us" answer at signup
  socialLinks      Json?     // [{ platform: "Twitter", url: "https://..." }, ...]
  projectType      String?   // "novel" | "fanfic" | "short_story" | "other"
  timeOnProject    String?   // "less_1month" | "1_6months" | "6_12months" | "over_1year"
  biggestBlock     String? 

  // ── public profile extras ────────────────────────────────────────────────
  country              String?    // free-text country / region
  genre                String?    // genre of story they mainly write, e.g. "Fantasy"
  funFact              String?    // short fun fact shown on the profile
  favoriteSprintTime   String?    // free-text, e.g. "Evenings (8–10pm WAT)"
  favoriteSprintDays   WeekDay[]  @default([]) // days they like to sprint on
  allowAskMeAnything   Boolean    @default(false) // opt-in: lets other writers message them straight from their profile

  blogLastSeen  BlogLastSeen?

  challengeLongestStreak   Int     @default(0)  

  // ── existing relations ──────────────────────────────────────────────────
  challengeParticipations  ChallengeParticipation[]
  challengeCheckIns        ChallengeCheckIn[]

  notificationPreference NotificationPreference?
  groupSprints        GroupSprint[]
  sprints             Sprint[]
  sprintRoomMessages  SprintRoomMessage[]
  sprintRoomPresences SprintRoomPresence[]
  sprintRoomNotifications SprintRoomNotification[]
  notification        Notification[]
  blogPostLikes       BlogPostLike[]
  blogComments        BlogComment[]
  blogReplies         BlogReply[]
  blogPostsAuthored   BlogPost[]     @relation("BlogPostAuthor")
  blogPostsReviewed   BlogPost[]     @relation("BlogPostReviewer")
  soundscapes         Soundscape[]
  writingDrafts       WritingDraft[]
  draftFolders        DraftFolder[]
  workspaceProfile      WorkspaceProfile?
  dailyWritingActivity  DailyWritingActivity[]
  

  // ── feedback hub relations ──────────────────────────────────────────────
  feedbackPoints              FeedbackPoint?
  feedbackSubmissions         FeedbackSubmission[]
  feedbackResponses           FeedbackResponse[]
  paragraphComments           ParagraphComment[]
  paragraphCommentReplies     ParagraphCommentReply[]
  paragraphCommentUpvotes     ParagraphCommentUpvote[]
  feedbackResponseUpvotes     FeedbackResponseUpvote[]
  critiqueReportsSubmitted    CritiqueReport[]  @relation("ReportSubmitter")
  critiqueReportsResolved     CritiqueReport[]  @relation("ReportResolver")

  blocksMade      UserBlock[]  @relation("BlocksMade")
  blocksReceived  UserBlock[]  @relation("BlocksReceived")

  // ── Direct Message relations ──────────────────────────────────────────────
  directConversationsAsA  DirectConversation[] @relation("ConversationUserA")
  directConversationsAsB  DirectConversation[] @relation("ConversationUserB")
  sentMessages            DirectMessage[]      @relation("MessageSender")

  // ── thread relations ─────────────────────────────────────────────────────
  threads             Thread[]
  threadLikes         ThreadLike[]
  threadComments      ThreadComment[]
  threadCommentLikes  ThreadCommentLike[]
  threadReplies       ThreadReply[]
  threadReplyLikes    ThreadReplyLike[]

  // ── draft plan relations ─────────────────────────────────────────────────
  // A writer can hold several plans now (DraftPlan.userId is no longer
  // @unique) — this back-relation must be a list, not a single optional
  // object, or the one-to-one @relation fails to validate (P1012).
  draftPlans           DraftPlan[]
  draftProgressLogs    DraftProgressLog[]
  draftBonusQuests     DraftBonusQuest[]

  // ── days challenge relations ─────────────────────────────────────────────
  daysChallenge        DaysChallenge?
  daysChallengeCheckIns DaysChallengeCheckIn[]

  // ── badges / mini-challenges ──────────────────────────────────────────────
  badges               UserBadge[]
  miniChallengeResults MiniChallengeResult[]

  // ── writer's dictionary ─────────────────────────────────────────────────
  dictionaryEntries    DictionaryEntry[]

  // ── mailbox ───────────────────────────────────────────────────────────
  mailboxCardsSent     MailboxCard[] @relation("MailboxCardSender")
  mailboxCardsReceived MailboxCard[] @relation("MailboxCardRecipient")

  // ── follow graph ──────────────────────────────────────────────────────
  following            Follow[]      @relation("Following")            // rows where THIS user is the follower
  followers            Follow[]      @relation("Followers")            // rows where THIS user is being followed

  // ── profile likes ─────────────────────────────────────────────────────
  profileLikesGiven    ProfileLike[] @relation("ProfileLikesMade")
  profileLikesReceived ProfileLike[] @relation("ProfileLikesReceived")
}

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int                          // the user who did the blocking
  blockedId Int                          // the user who was blocked
  createdAt DateTime @default(now())

  blocker   User     @relation("BlocksMade",     fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])       // can't block the same person twice
  @@index([blockerId])
  @@index([blockedId])
}

model ChallengeParticipation {
  id               Int           @id @default(autoincrement())
  userId           Int           @unique   // one active slot per writer at a time (enforced in service)
 
  // Goal the writer set when they joined
  goalValue        Int         @default(0) // e.g. 500 (words), 2 (chapters), 3 (scenes), 30 (minutes)
  goalType         GoalType    @default(WORDS)  // WORDS | CHAPTERS | SCENES | DURATION
 
  // Streak tracking
  currentStreak    Int           @default(0)
  longestStreak    Int           @default(0)   // local copy for leaderboard queries
  missedDaysInRow  Int           @default(0)
  lastCheckInDate  DateTime?
 
  joinedAt         DateTime      @default(now())
  isActive         Boolean       @default(true)
  remindersEnabled Boolean       @default(true)
 
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns  ChallengeCheckIn[]
 
  @@index([userId])
  @@index([isActive])
  @@index([currentStreak])
  @@index([joinedAt])
}

// One row per day a writer logs progress in a challenge.
model ChallengeCheckIn {
  id              Int      @id @default(autoincrement())
  participationId Int
  userId          Int
  checkInDate     DateTime                       // the calendar date (stored as midnight UTC)
  countLogged     Int                            // words or chapters logged for this day
  metDailyGoal    Boolean  @default(false)       // true if countLogged >= participation.dailyGoal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participation  ChallengeParticipation  @relation(fields: [participationId], references: [id], onDelete: Cascade)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Only one check-in entry per participation per day
  @@unique([participationId, checkInDate])
  @@index([participationId])
  @@index([userId])
  @@index([checkInDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// GROUP SPRINT & SPRINT
// ─────────────────────────────────────────────────────────────────────────────

model GroupSprint {
  id                Int        @id @default(autoincrement())
  userId            Int
  duration          Int
  totalWordsWritten Int        @default(0)
  liveKitRoomName   String?
  sprintType        SprintType @default(WRITING)
  startedAt         DateTime   @default(now())
  completedAt       DateTime?
  isActive          Boolean    @default(true)

  sprints           Sprint[]
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([startedAt])
}

model Sprint {
  id            Int          @id @default(autoincrement())
  userId        Int
  groupSprintId Int?
  soundscapeId  Int?
  draftId       Int?         // which draft file this sprint was written in, if any — solo sprints started from the drafts page pass this; older sprints and sprints not tied to a specific file leave it null
  duration      Int?         // sprint length in minutes, as set at start — nullable since older group sprints derived duration from GroupSprint instead
  startWords    Int          @default(0)
  currentWords  Int?                        // live word count while the sprint's in progress — pushed via the sprint:progress socket event, separate from endWords which is only set once at checkin. Null until the first live update comes in; also serves as the initial value for anyone loading the room page before that first update arrives.
  bankedWords   Int          @default(0) 
  endWords      Int?                        // raw word count at checkout; wordsWritten/deletedWords are derived from this - startWords
  wordsWritten  Int          @default(0)
  deletedWords  Int          @default(0)
  leftEarly     Boolean      @default(false) // true if the member left voluntarily (leaveSprint) rather than finishing a normal checkout — client uses this to skip the end-of-sprint ring for them
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
  isActive      Boolean      @default(true)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupSprint   GroupSprint?  @relation(fields: [groupSprintId], references: [id], onDelete: SetNull)
  soundscape    Soundscape?   @relation(fields: [soundscapeId], references: [id], onDelete: SetNull)
  draft         WritingDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([groupSprintId])
  @@index([isActive])
  @@index([soundscapeId])
  @@index([draftId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SPRINT ROOM
//
// The single, always-open room — NOT tied 1:1 to a single GroupSprint.
// Many GroupSprint sessions happen inside this room over its lifetime.
// Presence here ("who's in the room") is intentionally separate from Sprint
// ("who's actively sprinting") — a member can be present/tagged during
// check-in before ever clicking "Join Sprint". There is only ever one room
// (see sprintRoomService.fetchOrCreateDefaultRoom) — named distinctly from
// the Threads forum so members don't confuse the two.
// ─────────────────────────────────────────────────────────────────────────────

model SprintRoom {
  id        Int      @id @default(autoincrement())
  name      String   @default("Sprint Room")
  createdAt DateTime @default(now())

  messages  SprintRoomMessage[]
  presences SprintRoomPresence[]
}

// One row per user per room. Updated (not recreated) on join/leave/heartbeat.
// leftAt null + lastSeenAt recent = "currently in the room" for presence/tagging.
model SprintRoomPresence {
  id           Int        @id @default(autoincrement())
  sprintRoomId Int
  userId       Int
  joinedAt     DateTime   @default(now())
  lastSeenAt   DateTime   @default(now())
  leftAt       DateTime?

  sprintRoom   SprintRoom @relation(fields: [sprintRoomId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sprintRoomId, userId])
  @@index([sprintRoomId])
  @@index([leftAt])
}

model SprintRoomMessage {
  id               Int        @id @default(autoincrement())
  sprintRoomId     Int
  senderId         Int?       // nullable — preserved if user deleted, same pattern as ThreadComment
  content          String

  mentionedUserIds Int[]      @default([])   // parsed @tags — drives notifyUser()

  quotedMessageId  Int?
  quotedContent    String?
  quotedSenderName String?

  deletedAt        DateTime?
  createdAt        DateTime   @default(now())

  sprintRoom       SprintRoom @relation(fields: [sprintRoomId], references: [id], onDelete: Cascade)
  sender           User?      @relation(fields: [senderId], references: [id], onDelete: SetNull)
  notifications    SprintRoomNotification[]

  @@index([sprintRoomId])
  @@index([senderId])
  @@index([createdAt])
}

// A lightweight, dedicated notification — NOT written to the main
// Notification table, so it never shows up on the bell/inbox page.
// Mirrors the same "own page, own badge" pattern already used for direct
// messages (DirectConversation.lastReadByA/B) and community updates
// (BlogLastSeen): fired only for a REPLY (someone quoted your message) or
// a MENTION (someone @'d you), read in bulk when the chat panel is opened.
model SprintRoomNotification {
  id        Int      @id @default(autoincrement())
  userId    Int      // recipient — the person being mentioned or replied to
  messageId Int      // the SprintRoomMessage that triggered this
  kind      SprintRoomNotificationKind
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   SprintRoomMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([messageId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SOUNDSCAPE
// ─────────────────────────────────────────────────────────────────────────────

model Soundscape {
  id            Int       @id @default(autoincrement())
  name          String
  creatorName   String?
  fileUrl       String
  contributedBy Int
  isApproved    Boolean   @default(false)
  createdAt     DateTime  @default(now())

  contributor   User      @relation(fields: [contributedBy], references: [id], onDelete: Cascade)
  sprints       Sprint[]

  @@index([contributedBy])
  @@index([isApproved])
}

// ─────────────────────────────────────────────────────────────────────────────
// QUOTES, SUBSCRIPTIONS, NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Subscription {
  id           Int      @id @default(autoincrement())
  userId       Int
  subscription Json
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Notification {
  id           Int                  @id @default(autoincrement())
  username     String
  userId       Int
  message      String?
  link         String?
  read         Boolean?             @default(false)
  type         NotificationType     @default(GENERAL)
  category     NotificationCategory? // WRITING (draft plan, sprints) or COMMUNITY (new members, birthdays) — used for the Writing/Community tabs on the bell page. Nullable since older rows and some types (MESSAGE, MAILBOX_CARD, SYSTEM) don't cleanly belong to either.
  actorId      Int?                 // id of the writer who triggered this (sender, card-giver, etc.) — lets the frontend pop open that user's profile modal on click, independent of `link` (which now points wherever email/push should go, e.g. the workspace). Null for system/GENERAL notices with no single actor.
  actorAvatar  String?              // avatar of the writer who triggered this (sender, card-giver, etc.) — null for system/GENERAL notices with no single actor
  createdAt    DateTime             @default(now())
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([userId, type])
  @@index([userId, category])
}

// Which tab a notification shows up under on the bell page — a second axis
// alongside NotificationType (type is "what kind of event", category is
// "which of my two tabs does this belong in"). Only two values exist right
// now because only two tabs exist; add a third here (and a third tab on the
// frontend) if that ever changes.
enum NotificationCategory {
  WRITING    // draft plan progress/completion/halfway, sprint starts, new draft plans
  COMMUNITY  // new members, birthdays, new followers
}

// Used to filter what shows up on the main /notifications bell page.
// MESSAGE and COMMUNITY_UPDATE are reserved for completeness (e.g. future
// "all activity" views) but notifyUser() currently skips creating an inbox
// row for those two types entirely — they're represented by the dedicated
// Messages and Community Updates pages + sidebar badges instead.
enum NotificationType {
  GENERAL           // catch-all / legacy rows created before this field existed
  REACTION          // likes on posts, comments, threads, etc.
  COMMENT           // someone commented/replied on the user's content
  CRITIQUE          // feedback hub activity (new response, report resolved, etc.)
  MESSAGE           // new direct message — reserved, not currently written to inbox
  COMMUNITY_UPDATE  // new blog/community post — reserved, not currently written to inbox
  MAILBOX_CARD      // received a mailbox card — reserved, not currently written to inbox (mailbox has its own page + unread badge)
  SYSTEM            // account/admin-level notices
}

model NotificationPreference {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  preferences Json     @default("{}")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// BLOG
// ─────────────────────────────────────────────────────────────────────────────

model BlogPost {
  id        Int            @id @default(autoincrement())
  title     String?
  content   String
  mediaUrl  String?
  link      String?
  category  String?
  tag       String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  likes     BlogPostLike[]
  comments  BlogComment[]

  // ── series support ───────────────────────────────────────────────────────
  // A post can optionally belong to a series (e.g. an event's story
  // submissions). seriesOrder controls its position for "next/previous"
  // navigation. Posts with seriesId = null are standalone, single posts.
  seriesId    Int?
  seriesOrder Int?
  series      BlogSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  isPinned    Boolean  @default(false)

  // ── writer submissions / approval workflow ───────────────────────────────
  // Posts created directly by an admin are auto-APPROVED. Posts submitted by
  // regular writers (Writer's Commons submissions) start PENDING and only
  // appear publicly once an admin approves them. authorId is who wrote/
  // submitted the piece — kept null for classic admin posts that predate
  // this feature (they simply render with no byline).
  status       PostStatus @default(APPROVED)
  authorId     Int?
  author       User?      @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviewedById Int?
  reviewer     User?      @relation("BlogPostReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?

  @@index([createdAt])
  @@index([seriesId])
  @@index([seriesId, seriesOrder])
  @@index([isPinned])
  @@index([status])
  @@index([authorId])
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// BLOG SERIES
//
// Groups related blog posts together (e.g. an ongoing story, or all of the
// submissions for a community event) so they can be browsed as a collection
// and linked with "next/previous" navigation.
// ─────────────────────────────────────────────────────────────────────────────

model BlogSeries {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  description String?
  coverUrl    String?
  category    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  posts       BlogPost[]

  @@index([slug])
}

model BlogPostLike {
  id         Int      @id @default(autoincrement())
  userId     Int
  blogPostId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([userId, blogPostId])
  @@index([blogPostId])
}

model BlogComment {
  id         Int         @id @default(autoincrement())
  blogPostId Int
  authorId   Int?                                                         // <-- nullable
  content    String
  createdAt  DateTime    @default(now())
  post       BlogPost    @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  author     User?       @relation(fields: [authorId], references: [id], onDelete: SetNull) // <-- SetNull
  replies    BlogReply[]

  @@index([blogPostId])
  @@index([authorId])
}

model BlogReply {
  id        Int         @id @default(autoincrement())
  commentId Int
  authorId  Int?                                                          // <-- nullable
  content   String
  createdAt DateTime    @default(now())
  comment   BlogComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  author    User?       @relation(fields: [authorId], references: [id], onDelete: SetNull) // <-- SetNull

  @@index([commentId])
  @@index([authorId])
}

model BlogLastSeen {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  lastSeenAt DateTime @default(now())

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// THREADS  (admin-created forum posts; members like, comment, reply)
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// THREAD  — updated model (replace the existing Thread block)
// ─────────────────────────────────────────────────────────────────────────────
model Thread {
  id         Int      @id @default(autoincrement())
  authorId   Int                                         // any authenticated member
  tag        String?                                     // fixed tag set enforced in the controller; null = untagged
  title      String?                                     // optional — a thread can be posted with no title
  context    String                                      // body of the thread
  mediaUrl   String?                                     // first image — kept for back-compat with old cards/notifications
  mediaUrls  Json     @default("[]")                     // full image set, same pattern as ThreadComment/ThreadReply
  link       String?                                    // optional image/attachment
  isPinned   Boolean  @default(false)                    // only admins should pin
  isDeprioritized Boolean @default(false)                // admin-only: hidden from active/latest/pinned feeds,
                                                          // still shown (sorted last) in the plain thread list
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author    User              @relation(fields: [authorId],   references: [id], onDelete: Cascade)
  likes     ThreadLike[]
  comments  ThreadComment[]

  @@index([authorId])
  @@index([tag])
  @@index([createdAt])
  @@index([isPinned])
  @@index([isDeprioritized])
}

model ThreadLike {
  id       Int    @id @default(autoincrement())
  userId   Int
  threadId Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([threadId])
}

model ThreadComment {
  id        Int      @id @default(autoincrement())
  threadId  Int
  authorId  Int?  // nullable — preserved if user deleted
  mediaUrl   String?
  mediaUrls  Json    @default("[]")                               
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread  Thread              @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author  User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  likes   ThreadCommentLike[]
  replies ThreadReply[]

  @@index([threadId])
  @@index([authorId])
}

model ThreadCommentLike {
  id        Int           @id @default(autoincrement())
  userId    Int
  commentId Int
  createdAt DateTime      @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment ThreadComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model ThreadReply {
  id        Int      @id @default(autoincrement())
  commentId Int
  // Self-reference for Reddit-style nested threading. Null = a direct reply
  // to the top-level comment. Non-null = a reply to another reply, letting
  // the thread nest arbitrarily deep instead of staying a flat list.
  parentId  Int?
  authorId  Int?    // nullable — preserved if user deleted
  content   String
  mediaUrl   String?
  mediaUrls   Json    @default("[]")                                      
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comment  ThreadComment     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  parent   ThreadReply?      @relation("ReplyToReply", fields: [parentId], references: [id], onDelete: Cascade)
  children ThreadReply[]     @relation("ReplyToReply")
  author   User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  likes    ThreadReplyLike[]

  @@index([commentId])
  @@index([parentId])
  @@index([authorId])
}

model ThreadReplyLike {
  id        Int         @id @default(autoincrement())
  userId    Int
  replyId   Int
  createdAt DateTime    @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply ThreadReply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, replyId])
  @@index([replyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// DRAFT PLAN
// ─────────────────────────────────────────────────────────────────────────────
// A writer's personalised drafting plan, created through the three-step
// onboarding flow. Writers can hold MULTIPLE plans at once (e.g. a novel
// and a side project) — userId is intentionally NOT unique. Ownership is
// checked in the service layer on every read/write (findFirst({id, userId})
// instead of findUnique({userId})). A soft cap on how many active
// (isCompleted: false) plans one writer can hold at a time is enforced in
// draftPlanService.createPlan (MAX_ACTIVE_PLANS), not here.
// ─────────────────────────────────────────────────────────────────────────────

model DraftPlan {
  id               Int      @id @default(autoincrement())
  userId           Int      // NOT unique — a writer can have several plans

  // ── Step 1 — The Math Layer ──────────────────────────────────────────────
  storyTitle       String   // Step 3 — name of their story (stored here for convenience)
  premise          String   // Step 3 — story premise

  wordsWrittenSoFar   Int              // starting word count at plan creation
  targetLength        Int              // overall project goal in words
  goalType            DraftGoalType    // WORDS | CHAPTERS | SCENES
  dailyGoal           Int              // reduced expectation value (words/chapters/scenes per day)
  writingDays         DraftWritingDay[] // which days they typically write

  // ── Step 2 — The Emotional Layer ────────────────────────────────────────
  // Simplified down to a single field — everything else (whatItMeans,
  // dailyTreat, weeklyTreat, inspirationSource) has been removed; it isn't
  // shown anywhere in the redesigned draft plan UI.
  whyFinish        String   // "Why am I writing this story?"

  // ── Images ──────────────────────────────────────────────────────────────
  // Up to 5 moodboard images stored as URL strings in a Json array.
  // Character fields have been removed entirely (DraftPlanCharacter model
  // dropped below) — the moodboard is now the only visual section on a plan.
  moodboardImages  Json     @default("[]")   // String[] — up to 5 URLs

  // ── Computed / Derived ───────────────────────────────────────────────────
  estimatedDays    Int      // days to finish at daily goal, calculated at creation
  weeklyGoal       Int      // dailyGoal * active writing days per week

  // ── Status ───────────────────────────────────────────────────────────────
  isCompleted      Boolean  @default(false)
  completedAt      DateTime?
  halfwayNotifiedAt DateTime? // set once "50% done" is reached and followers have been notified — prevents re-notifying on every log after crossing the threshold

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressLogs     DraftProgressLog[]
  bonusQuests      DraftBonusQuest[]
  bonusQuestProgress DraftBonusQuestProgress[]

  // The one folder auto-created alongside this plan — see DraftFolder model.
  // Optional here only because Prisma requires it on both sides of a 1:1;
  // in practice every plan gets a folder the moment it's created and it's
  // never removed except by deleting the plan itself.
  draftFolder      DraftFolder?

  @@index([userId])
  @@index([userId, isCompleted])
  @@index([userId, updatedAt])
  @@index([isCompleted])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// DRAFT PROGRESS LOG
// One row per calendar day on a writer's timeline. A row can represent:
//   - an actual logged writing session (countLogged > 0), OR
//   - a day the writer has *pre-planned* only (chapterLabel/note/isPickedDay
//     set ahead of time, countLogged still 0 — e.g. ticking the "planned
//     writing day" toggle for a future date and naming the chapter before
//     any words are written).
// isPickedDay is stored per-row (not just derived from the recurring weekly
// DraftWritingDay pattern) so a writer can override a single date — mark an
// unplanned day as a bonus writing day, or unmark a normally-planned date.
// Timeline status (DONE / BONUS / MISSED / PLANNED) is computed from these
// fields at read time in the service layer, not stored.
// ─────────────────────────────────────────────────────────────────────────────

model DraftProgressLog {
  id             Int      @id @default(autoincrement())
  planId         Int
  userId         Int
  logDate        DateTime // calendar date stored as midnight UTC
  countLogged    Int      @default(0) // words/chapters/scenes logged for this day; 0 = pre-planned only, nothing written yet
  isPickedDay    Boolean  @default(false) // true if this specific date counts as a planned writing day (overrides the recurring weekly pattern)
  isBonusDayGoalOptIn Boolean @default(false) // true if, on an unplanned (bonus) day, the writer chose "Daily Goal" over the Quest — counts this log toward sessionsDone/weekTotal/avgPace the same as a picked day (see getPlanProgress), while the day still renders as a Bonus Day card, not a picked day, since isPickedDay itself stays false
  metDailyGoal   Boolean  @default(false)
  totalSoFar     Int      // running word count after this log (wordsWrittenSoFar + all logs)
  chapterLabel   String?  // task/chapter the writer is working on this day, e.g. "Chapter 9 — Opening"
  note           String?  // optional journal entry for the day
  timeSpent      Int?     // optional — minutes spent writing this session; null means not recorded, not "0 minutes"

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  plan           DraftPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per plan per calendar day
  @@unique([planId, logDate])
  @@index([planId])
  @@index([userId])
  @@index([logDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// DRAFT WRITING DAY  (join table — which days of the week the writer is active)
// ─────────────────────────────────────────────────────────────────────────────

model DraftWritingDay {
  id              Int      @id @default(autoincrement())
  planId          Int
  day             WeekDay
  reminderTime    String   // "HH:MM" in writer's local time, display-only
  reminderTimeUTC String   // "HH:MM" UTC, used by the reminder cron
  plan            DraftPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@unique([planId, day])
  @@index([planId])
  @@index([reminderTimeUTC, day]) // speeds up the cron's per-minute scan
}

// ─────────────────────────────────────────────────────────────────────────────
// DRAFT BONUS QUEST
// Opt-in alternative to a normal progress log, offered only on a day that is
// NOT one of the writer's picked writing days (see isRecurringPickedDay /
// DraftProgressLog.isPickedDay — same rule both places). Deliberately kept
// OUTSIDE the story's word count: countLogged/targetCount here never feed
// DraftPlan.wordsWrittenSoFar, totalSoFar, or targetLength math, because a
// 400-word prompt about a stranger at midnight isn't chapter progress. It
// still counts toward the writer's streak and "wrote today" status (see
// DailyWritingActivity.hasBonusQuestActivity in writingActivityService) —
// showing up unprompted should count for something, just not for the book.
// One quest per plan per calendar day, same shape as DraftProgressLog.
// ─────────────────────────────────────────────────────────────────────────────
model DraftBonusQuest {
  id            Int             @id @default(autoincrement())
  planId        Int
  userId        Int
  logDate       DateTime        // calendar date, midnight UTC

  questType     BonusQuestType
  status        BonusQuestStatus @default(CHOOSING) // CHOOSING → offering two candidates | ACTIVE → one picked, logging words | DECLINED → writer passed on both, done for the day

  // ── Candidates offered at CHOOSING — snapshotted at open time (see
  // pickCandidates in draftPlanService.js) so the offer stays stable even
  // if the underlying BonusQuestPrompt rows change later.
  candidateAOrderIndex  Int
  candidateAPrompt      String
  candidateATargetCount Int
  candidateBOrderIndex  Int
  candidateBPrompt      String
  candidateBTargetCount Int

  // ── Set once the writer picks A or B (pickBonusQuestPrompt) — null while
  // still CHOOSING, stays null forever if DECLINED.
  promptOrderIndex Int?         // which BonusQuestPrompt.orderIndex (within questType) this quest was assigned from
  prompt           String?      // snapshotted prompt text — kept even if the BonusQuestPrompt row is later edited/removed
  targetCount      Int?         // this quest's own word target — snapshotted from BonusQuestPrompt at assignment time

  countLogged   Int             @default(0)
  note          String?         // optional journal entry for today's quest — separate from DraftProgressLog.note since a bonus day can carry both a Daily Goal note and a Quest note
  timeSpent     Int?            // optional — minutes spent on the quest; null means not recorded, not "0 minutes"
  isCompleted   Boolean         @default(false)
  completedAt   DateTime?
  declinedAt    DateTime?       // set when status flips to DECLINED

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  plan          DraftPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per plan per calendar day
  @@unique([planId, logDate])
  @@index([planId])
  @@index([userId])
  @@index([logDate])
  @@index([status])
}
// ─────────────────────────────────────────────────────────────────────────────
// BONUS QUEST PROMPT  (seedable content table — see prisma/seeds/bonusQuestPrompts.js)
// The actual quest content, kept OUT of code so it can be edited/expanded by
// re-running the seed file instead of shipping a deploy. orderIndex is
// 1-based and defines delivery order WITHIN a questType — see
// DraftBonusQuestProgress below for how that order gets walked per writer.
// Not a join table off DraftPlan/User — this is shared reference content,
// same relationship MiniChallengeTemplate has to MiniChallengeWeekAssignment.
// ─────────────────────────────────────────────────────────────────────────────
model BonusQuestPrompt {
  id           Int             @id @default(autoincrement())
  questType    BonusQuestType
  orderIndex   Int             // 1-based position within this questType; determines hand-out order
  prompt       String
  targetCount  Int             // word target for this specific prompt (lets targets vary prompt-to-prompt if wanted)

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // One prompt per position per type — this is what lets openBonusQuest look
  // up "the Nth prompt of type X" directly instead of scanning/sorting.
  @@unique([questType, orderIndex])
  @@index([questType])
}

// ─────────────────────────────────────────────────────────────────────────────
// DRAFT BONUS QUEST PROGRESS  (per-plan cursor through each quest type's list)
// Tracks, per plan per questType, which BonusQuestPrompt.orderIndex is next
// in line. The wheel still randomly picks WHICH type a writer gets on a
// given bonus day, but within that type prompts are handed out 1, 2, 3...
// in order — never repeated or shuffled — and wrap back to 1 once the list
// is exhausted. nextIndex starts at 1 (nothing written yet for that type).
// ─────────────────────────────────────────────────────────────────────────────
model DraftBonusQuestProgress {
  id               Int             @id @default(autoincrement())
  planId           Int
  questType        BonusQuestType
  usedOrderIndexes Int[]           @default([]) // orderIndexes of prompts actually PICKED for this type — an offered-but-passed-over prompt stays eligible (see pickCandidates); resets once the whole type's list has been picked through

  updatedAt        DateTime        @updatedAt

  plan             DraftPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // One cursor per plan per quest type
  @@unique([planId, questType])
  @@index([planId])
}

// ─────────────────────────────────────────────────────────────────────────────
// EVENT  (admin-created community events, e.g. "Design Your Summer Writing Routine")
// ─────────────────────────────────────────────────────────────────────────────
// Members can only join an event if they already have an active DraftPlan.
// On purpose, Event does NOT hold a Prisma relation to DraftPlan — we just
// keep a flat list of the DraftPlan ids that joined (participantPlanIds).
// This keeps Event fully decoupled: a DraftPlan can be deleted/recreated
// without cascading into the event, and we don't need a join table for
// what is really just "which plans opted in".
//
// When the event ends, a job (cron or manual admin trigger) walks
// participantPlanIds, looks up each DraftPlan, and — for every plan that
// hit its writing target (isCompleted = true) — grants that writer a
// UserBadge (sourceType: EVENT) snapshotting badgeName/badgeIcon. This
// never touches User.role, which stays a clean permission enum.
// ─────────────────────────────────────────────────────────────────────────────

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  imageUrl    String?

  startDate   DateTime
  endDate     DateTime

  // Badge granted to anyone whose linked DraftPlan is complete when the
  // event is finalized. Stored here as the "source of truth" the admin
  // edits; UserBadge copies these values at the moment each badge is
  // earned, so later edits here don't alter badges already awarded.
  badgeName   String
  badgeIcon   String

  // Flat list of DraftPlan ids that joined this event.
  // No relation — see note above. Prisma lets us `push` to this natively.
  participantPlanIds Int[] @default([])

  status      EventStatus @default(UPCOMING)
  finalizedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// MINI CHALLENGES  (always-on weekly achievement rotation)
// ─────────────────────────────────────────────────────────────────────────────
// Fully decoupled from Event — there's no "joining". A small pool of
// MiniChallengeTemplate rows cycles automatically week after week for the
// whole community (which one is "live" for any given week is pure math —
// see minichallengeservice.js's rotation resolver). A sweep evaluates each
// user's own existing activity (Sprint / DraftProgressLog /
// DaysChallengeCheckIn) against that week's template once their local week
// has closed, records one idempotent MiniChallengeResult per user per week,
// and — if they cleared the bar — grants a UserBadge with claimedAt left
// null until the user taps "claim" on their profile.
// ─────────────────────────────────────────────────────────────────────────────

// One row per week that's actually been resolved — created the first time
// getLiveTemplate() is asked about that week, and never overwritten after
// that (unless the assigned template gets paused mid-week — see
// getLiveTemplate). This is what stops adding/pausing/enabling a template
// from reshuffling a week that's already in progress: the rotation math in
// getLiveTemplate is only consulted for weeks that haven't been locked in
// yet.
model MiniChallengeWeekAssignment {
  id         Int      @id @default(autoincrement())
  weekStart  DateTime @unique
  templateId Int
  createdAt  DateTime @default(now())

  template MiniChallengeTemplate @relation(fields: [templateId], references: [id])

  @@index([templateId])
}

model MiniChallengeTemplate {
  id            Int               @id @default(autoincrement())
  title         String            // e.g. "Session Sprint Week"
  description   String?
  type          MiniChallengeType
  targetValue   Int               // ignored for WEEKLY_GOAL — everyone's own DraftPlan.weeklyGoal applies instead
  badgeName     String
  badgeIcon     String
  rotationOrder Int               @unique   // 0, 1, 2, 3... position in the cycle
  isActive      Boolean           @default(true)   // pause a type without deleting its history
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  results       MiniChallengeResult[]
  weekAssignments MiniChallengeWeekAssignment[]

  @@index([rotationOrder])
  @@index([isActive])
}

enum MiniChallengeType {
  SESSION_COUNT     // activity logged on >= targetValue distinct days this week (DraftPlan log OR DaysChallenge check-in)
  WEEKLY_GOAL       // sum of DraftProgressLog.countLogged this week >= the writer's own DraftPlan.weeklyGoal
  SPRINT_COUNT      // >= targetValue completed Sprints this week (does not need to be consecutive days)
  CONSECUTIVE_DAYS  // longest run of consecutive days *within this week* with writing activity (DraftPlan log OR DaysChallenge check-in) >= targetValue
  CONSECUTIVE_SPRINT_DAYS // longest run of consecutive days *within this week* with a completed Sprint >= targetValue
}

// One row per writer per evaluated week — keeps the sweep idempotent (never
// double-processes anyone) and doubles as "this week's challenge" data.
model MiniChallengeResult {
  id            Int      @id @default(autoincrement())
  templateId    Int
  userId        Int
  weekStart     DateTime // Monday of the evaluated week (the writer's own local calendar week)

  achievedValue Int
  targetValue   Int?     // snapshot of the bar they were evaluated against (writer's own weeklyGoal for WEEKLY_GOAL)
  completed     Boolean
  evaluatedAt   DateTime @default(now())

  template MiniChallengeTemplate @relation(fields: [templateId], references: [id])
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([weekStart, userId])   // one evaluated challenge per person per week
  @@index([templateId])
  @@index([userId])
  @@index([weekStart])
}

// ── Earned badges, shown on the profile page ──────────────────────────────
// Snapshot, not a live FK — an Event/MiniChallengeTemplate can be edited or
// disabled later without altering or deleting badges people already earned.
model UserBadge {
  id         Int             @id @default(autoincrement())
  userId     Int

  name       String          // snapshot of badgeName at the moment earned
  icon       String          // snapshot of badgeIcon
  sourceType BadgeSourceType
  sourceId   Int             // Event.id, or MiniChallengeTemplate.id for weekly badges — informational only, no FK
  weekStart  DateTime?       // set only for MINI_CHALLENGE badges — null for EVENT/MILESTONE badges

  earnedAt   DateTime  @default(now())
  claimedAt  DateTime?        // null = unclaimed, shows the "claim" moment on profile

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId, weekStart])  // can't earn the exact same badge twice
  @@index([userId])
  @@index([claimedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// DIRECT MESSAGES
// A private two-person chat between any two members.
//
// Each pair of users gets exactly one Conversation room. The room is keyed on
// (userAId, userBId) where userAId is always the lower of the two user IDs —
// this canonical ordering means we can never accidentally create a duplicate
// room for the same pair.
//
// Messages live inside a Conversation. A message may optionally quote one
// earlier message (quotedMessageId) so the reader knows which message is being
// replied to. Quoted content is stored as a snapshot (quotedContent,
// quotedSenderName) so the quote still renders even if the original is deleted.
//
// Soft-delete: messages are never hard-deleted. deletedAt is set instead, and
// the API returns placeholder text ("This message was deleted") in that case.
// ─────────────────────────────────────────────────────────────────────────────

model DirectConversation {
  id      Int @id @default(autoincrement())

  // Always stored with userAId < userBId — enforced in the service layer.
  // The @@unique below prevents duplicate rooms for the same pair.
  userAId Int
  userBId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Per-participant read cursor.
  // Set to now() when that user opens the conversation.
  // A conversation is "unread" for userA if lastReadByA < the latest message's createdAt.
  lastReadByA  DateTime?
  lastReadByB  DateTime?

  userA    User             @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User             @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model DirectMessage {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String

  // Quote / reply context — optional
  // When a user replies to a specific message we store the ID of the original
  // message plus a snapshot of its text and sender name. The snapshot means
  // the quote still shows up even if the original message is later deleted.
  quotedMessageId   Int?
  quotedContent     String?  // snapshot of the quoted message's text at send time
  quotedSenderName  String?  // snapshot of the quoted sender's username at send time

  // Soft delete — we never physically remove messages
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User               @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  // Self-referential — the message being quoted (for integrity checks only;
  // the snapshot fields are what we actually render)
  quotedMessage  DirectMessage?  @relation("MessageQuote", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  quotedBy       DirectMessage[] @relation("MessageQuote")

  @@index([conversationId])
  @@index([senderId])
  @@index([quotedMessageId])
}


// ─────────────────────────────────────────────────────────────────────────────
// DAYS CHALLENGE  (7-day or 15-day focused writing challenge)
// ─────────────────────────────────────────────────────────────────────────────
// Completely separate from the existing ChallengeParticipation system.
// Writers join for a specific focus (up to 2) — editing, outlining,
// brainstorming, or story development. They set a daily goal in words or
// minutes. One active challenge per writer at a time.
//
// Lifecycle:
//   ACTIVE   → writer is in progress
//   COMPLETED → writer marked done early, or hit all days
//   EXPIRED  → challenge duration passed without completion (cron sets this)
// ─────────────────────────────────────────────────────────────────────────────


model DaysChallenge {
  id               Int                    @id @default(autoincrement())
  userId           Int                    @unique

  duration         DaysChallengeDuration
  focuses          DaysChallengesFocus[]

  storyTitle       String?
  workingGoal      String
  whyNow           String

  goalType         DaysChallengeGoalType
  dailyGoal        Int

  // ── NEW: daily check-in reminder ────────────────────────────────────────
  // "HH:MM" in the writer's own local time, display-only.
  reminderTime     String                 @default("09:00")
  // "HH:MM" in UTC — derived from reminderTime + the writer's User.timezone
  // at creation/update time. This is what the cron actually matches on, so
  // it never has to do timezone math per-tick.
  reminderTimeUTC  String                 @default("09:00")

  startDate        DateTime               @default(now())
  endDate          DateTime
  completedAt      DateTime?
  expiredAt        DateTime?

  status           DaysChallengeStatus    @default(ACTIVE)

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns         DaysChallengeCheckIn[]

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@index([createdAt])
  // NEW — speeds up the per-minute cron scan, same role as the index on
  // DraftWritingDay(reminderTimeUTC, day).
  @@index([reminderTimeUTC, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// DAYS CHALLENGE FOCUS  (join table — up to 2 focus rows per challenge)
// ─────────────────────────────────────────────────────────────────────────────

model DaysChallengesFocus {
  id          Int                   @id @default(autoincrement())
  challengeId Int
  focus       DaysChallengeFocus    // OUTLINING | BRAINSTORMING | EDITING | STORY_DEVELOPMENT

  challenge   DaysChallenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, focus])    // can't pick the same focus twice
  @@index([challengeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// DAYS CHALLENGE CHECK-IN
// One row per day a writer logs progress. One per challenge per calendar day
// (upsertable — they can re-log to correct their count).
// ─────────────────────────────────────────────────────────────────────────────

model DaysChallengeCheckIn {
  id            Int      @id @default(autoincrement())
  challengeId   Int
  userId        Int
  checkInDate   DateTime // midnight UTC
  countLogged   Int      // words or minutes depending on goalType
  metDailyGoal  Boolean  @default(false)
  note          String?  // optional note for the day

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  challenge     DaysChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, checkInDate])  // one check-in per challenge per day
  @@index([challengeId])
  @@index([userId])
  @@index([checkInDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// FEEDBACK HUB
// ─────────────────────────────────────────────────────────────────────────────

model FeedbackHubBootstrap {
  id        Int      @id @default(autoincrement())
  posterCount Int    @default(0)

  @@map("feedback_hub_bootstrap")
}

model FeedbackPoint {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  postingBalance Int      @default(5)
  reputation     Int      @default(5)
  usedFreePost   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FeedbackSubmission {
  id               Int              @id @default(autoincrement())
  userId           Int
  title            String
  genre            String
  summary          String
  content          String
  critiqueCount    Int              @default(0)
  status           SubmissionStatus @default(QUEUE)
  wordCountTier    WordCountTier
  actualWordCount  Int
  draftStage       DraftStage
  contentWarnings  String[]
  feedbackWanted   String[]
  pointsCost       Int
  wasFreePost      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  isDraft          Boolean          @default(false)
  unpublishedAt    DateTime?

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses         FeedbackResponse[]
  paragraphComments ParagraphComment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([genre])
}

model FeedbackResponse {
  id                  Int                @id @default(autoincrement())
  submissionId        Int
  criticId            Int?                                               // <-- nullable
  generalFeedback     String
  tagResponses        Json?              // optional per-tag feedback, keyed by feedbackWanted tag name
  pointsEarned        Int
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  submission  FeedbackSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  critic      User?                  @relation(fields: [criticId], references: [id], onDelete: SetNull) // <-- SetNull
  upvotes     FeedbackResponseUpvote[]
  reports     CritiqueReport[]

  @@index([submissionId])
  @@index([criticId])
}

model FeedbackResponseUpvote {
  id         Int              @id @default(autoincrement())
  userId     Int
  responseId Int
  createdAt  DateTime         @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  response   FeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([userId, responseId])
  @@index([responseId])
}

model CritiqueReport {
  id          Int           @id @default(autoincrement())

  // Who filed the report
  reporterId  Int
  reporter    User          @relation("ReportSubmitter", fields: [reporterId], references: [id], onDelete: Cascade)

  // Which critique (FeedbackResponse) is being reported
  responseId  Int
  response    FeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  // Report content
  reason      String                              // e.g. "Harassment", "Spam", "Unhelpful"
  details     String?                             // optional longer description (≤ 2,000 chars)

  // Lifecycle
  status      ReportStatus  @default(PENDING)
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  // Admin who resolved it + optional internal notes
  resolverId  Int?
  resolver    User?         @relation("ReportResolver", fields: [resolverId], references: [id], onDelete: SetNull)
  adminNotes  String?

  // One report per user per critique
  @@unique([reporterId, responseId])

  @@index([responseId])
  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
}

model ParagraphComment {
  id             Int                @id @default(autoincrement())
  submissionId   Int
  authorId       Int?                                                    // <-- nullable
  paragraphIndex Int
  content        String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  submission  FeedbackSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author      User?                  @relation(fields: [authorId], references: [id], onDelete: SetNull) // <-- SetNull
  upvotes     ParagraphCommentUpvote[]
  replies     ParagraphCommentReply[]

  @@index([submissionId])
  @@index([submissionId, paragraphIndex])
  @@index([authorId])
}

model ParagraphCommentUpvote {
  id        Int              @id @default(autoincrement())
  userId    Int
  commentId Int
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   ParagraphComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model ParagraphCommentReply {
  id        Int              @id @default(autoincrement())
  commentId Int
  authorId  Int?                                                         // <-- nullable
  content   String
  createdAt DateTime         @default(now())

  comment   ParagraphComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  author    User?            @relation(fields: [authorId], references: [id], onDelete: SetNull) // <-- SetNull

  @@index([commentId])
  @@index([authorId])
}

// ─────────────────────────────────────────────────────────────────────────────
// DRAFT FOLDERS
//
// Every WritingDraft now lives inside a folder — there's no such thing as a
// loose draft file anymore. Two flavors, distinguished only by draftPlanId:
//
//   - draftPlanId set    → auto-created the moment a DraftPlan is created
//     (see draftplanservice.js — createPlan should call
//     draftFolderService.createFolderForPlan(plan) right after the plan row
//     is inserted). One per plan, enforced by the @unique below. Deleted
//     automatically (and every draft file inside it, via cascade) if the
//     plan itself is deleted. Can't be renamed or deleted on its own — its
//     display name is always read live off draftPlan.storyTitle, never
//     stored here, so it can never drift out of sync if the writer renames
//     their story later.
//
//   - draftPlanId null    → an ordinary folder the writer made themselves
//     to hold drafts that aren't tied to any story plan (one-offs, side
//     pieces, whatever doesn't belong to a tracked project). `name` is
//     required for these. A writer can make as many as they like.
// ─────────────────────────────────────────────────────────────────────────────

model DraftFolder {
  id          Int      @id @default(autoincrement())
  userId      Int

  // Set only for a plan's auto-created folder; null for a general folder.
  draftPlanId Int?     @unique

  // Required for general folders; always null for a plan-linked folder
  // (see note above — those read their name off the plan instead).
  name        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  draftPlan   DraftPlan?     @relation(fields: [draftPlanId], references: [id], onDelete: Cascade)
  drafts      WritingDraft[]

  @@index([userId])
}

model WritingDraft {
  id                   Int                 @id @default(autoincrement())
  userId               Int
  title                String?
  content              String              @default("")
  wordCount            Int                 @default(0)

  // Every draft file lives inside a folder — either the one auto-created
  // for a DraftPlan, or a general folder the writer made themselves. See
  // DraftFolder model above.
  folderId             Int?
  folder               DraftFolder?         @relation(fields: [folderId], references: [id], onDelete: Cascade)

  // Writer-only scratch notes ("what to fix/add") — draft-overall (paragraphIndex
  // null) or attached to a specific paragraph. Cascades away with the draft row.
  stickyNotes          StickyNote[]

  // Sprints written in this specific file — used to surface "last sprint"
  // on the drafts page. A sprint keeps its own row even if the draft it
  // was tied to gets deleted (draftId just goes null, see Sprint model).
  sprints              Sprint[]

  // Lets a writer flag a draft as a priority — starred drafts sort to the
  // top of the drafts list and can be filtered to on their own.
  isStarred            Boolean             @default(false)

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([folderId])
  @@index([createdAt])
  @@index([userId, isStarred])
}

// ─────────────────────────────────────────────────────────────────────────────
// STICKY NOTES
//
// Writer-private scratch notes for a draft — "what do I still want to fix or
// add here". Two flavors, distinguished only by paragraphIndex:
//   - paragraphIndex = null  → attached to the draft as a whole
//   - paragraphIndex = 0..n  → attached to a specific paragraph in the editor
//
// Deliberately minimal: a colour, some free text, and/or a short checklist of
// items. No threading, no mentions, no critique-hub visibility — these are
// never shown to anyone but the draft's own writer, and only while the
// underlying WritingDraft row exists. The moment a chapter is posted or
// republished to the Critique Hub, its WritingDraft row (and therefore every
// StickyNote on it, via cascade) is deleted — so sticky notes never carry
// over into the feedback/critique stage. If the writer later unpublishes the
// chapter back into a draft, they start with a clean slate of notes.
// ─────────────────────────────────────────────────────────────────────────────

model StickyNote {
  id             Int             @id @default(autoincrement())
  draftId        Int
  userId         Int                              // draft owner; denormalized for convenient auth checks

  paragraphIndex Int?                              // null = whole-draft note; otherwise 0-based paragraph position
  color          StickyNoteColor @default(YELLOW)
  text           String          @default("")
  items          String[]        @default([])      // short checklist lines, e.g. "Tighten this dialogue"

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  draft          WritingDraft    @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@index([draftId, paragraphIndex])
}

// ─────────────────────────────────────────────────────────────────────────────
// WRITER'S DICTIONARY
//
// A writer's own personal glossary — invented words, worldbuilding terms,
// character names, whatever they want to keep a definition for. Private to
// the writer (scoped by userId), just a word + its meaning. Deliberately
// minimal for now: add / delete / fetch only, no folders, tags, or sharing.
// ─────────────────────────────────────────────────────────────────────────────

model DictionaryEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  word      String   // the term itself, as typed (case preserved for display)
  meaning   String   // its definition

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Case-sensitive DB backstop against exact duplicates. Case-insensitive
  // duplicate checking (so "Elf" and "elf" can't both be added) is handled
  // in the service layer via a `mode: "insensitive"` lookup before create.
  @@unique([userId, word])
  @@index([userId])
  @@index([userId, word])
}


// ─────────────────────────────────────────────────────────────────────────────
// WORKSPACE PROFILE
// One free-text field for now: "what kind of writer do you want to become."
// Split out from User (rather than a plain field on it) so it has room to
// grow — future workspace-only settings land here without touching User.
// ─────────────────────────────────────────────────────────────────────────────

model WorkspaceProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  aspiration  String?  // "What type of writer do you want to become?"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// DAILY WRITING ACTIVITY
// One row per writer per calendar day (midnight UTC, computed via the same
// todayInTimezone/toMidnightUTC helpers used elsewhere), aggregating writing
// activity from all three sources: plain draft edits, sprints, and draft-plan
// progress logs.
//
// hasSprintActivity / hasLogActivity are the ONLY fields streaks are built
// from — a plain autosave shouldn't make or break a writer's streak, since
// it can fire without any deliberate "I wrote today" action. wordsFromDrafts
// still feeds the history/output stats though, since that's a fair measure
// of actual output.
//
// wordsFromLog / chaptersFromLog / scenesFromLog mirror whatever
// DraftProgressLog.countLogged says for that day+goalType — same "this row
// stores the day's total, not a delta" convention DraftProgressLog itself
// uses, so re-logging/correcting a day stays idempotent here too.
// ─────────────────────────────────────────────────────────────────────────────

model DailyWritingActivity {
  id                Int      @id @default(autoincrement())
  userId            Int
  date              DateTime // calendar date, midnight UTC — one row per user per day

  wordsFromDrafts   Int      @default(0) // net positive word delta from plain (non-sprint) draft edits, accumulated across saves that day
  wordsFromSprints  Int      @default(0) // words written during sprints that day
  minutesFromSprints Int     @default(0) // minutes spent sprinting that day (actual elapsed time per sprint, summed) — powers the sprint WPM shown in Community "Writing today"
  sprintCount       Int      @default(0) // how many sprints were checked in that day — lets "Writing today" show "sprinted 3x" vs a single sprint's own stats
  wordsFromLog      Int      @default(0) // draft plan log for that day, WORDS-type plans only
  chaptersFromLog   Int      @default(0) // draft plan log for that day, CHAPTERS-type plans only
  scenesFromLog     Int      @default(0) // draft plan log for that day, SCENES-type plans only
  wordsFromBonusQuest Int    @default(0) // Bonus Quest words for that day — kept OUT of wordsFromLog on purpose, so it never inflates "real" story-output totals (getHistory's words sum, totalWordsAcrossDrafts, etc.)

  hasSprintActivity Boolean  @default(false) // streak source
  hasLogActivity    Boolean  @default(false) // streak source
  hasBonusQuestActivity Boolean @default(false) // streak source — a completed Bonus Quest counts as "showed up" same as a sprint or log

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// MAILBOX  (writer-to-writer cards — no replies, no likes, no threads)
// ─────────────────────────────────────────────────────────────────────────────
// Deliberately the simplest possible model: one row per card sent. A writer
// picks one of four fixed card types and can attach a short personal note.
// That's it — no reply chain, no reactions, no read receipts visible to the
// sender. readAt exists only so the RECIPIENT's own mailbox can show an
// unread badge; it's never exposed to the sender (no "seen" indicator),
// which is what keeps this from quietly turning into DMs.
// ─────────────────────────────────────────────────────────────────────────────

model MailboxCard {
  id          Int             @id @default(autoincrement())
  senderId    Int
  recipientId Int
  type        MailboxCardType

  note        String          // required — the writer's own greeting/message; the card type alone isn't the send, this is

  createdAt   DateTime        @default(now())
  readAt      DateTime?       // set once when the recipient opens their mailbox and views this card — powers an unread count, nothing more

  sender      User @relation("MailboxCardSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User @relation("MailboxCardRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([recipientId, readAt]) // unread-count lookups filter on exactly this pair
}

// ─────────────────────────────────────────────────────────────────────────────
// FOLLOW  (writer-to-writer follow graph)
// ─────────────────────────────────────────────────────────────────────────────

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int      // the user doing the following
  followingId Int      // the user being followed
  createdAt   DateTime @default(now())

  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId]) // can't follow the same person twice
  @@index([followerId])
  @@index([followingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PROFILE LIKE  (a simple "like" on another writer's profile)
// ─────────────────────────────────────────────────────────────────────────────

model ProfileLike {
  id          Int      @id @default(autoincrement())
  likerId     Int      // the user who liked
  likedUserId Int      // the profile that got liked
  createdAt   DateTime @default(now())

  liker       User     @relation("ProfileLikesMade",     fields: [likerId],     references: [id], onDelete: Cascade)
  likedUser   User     @relation("ProfileLikesReceived", fields: [likedUserId], references: [id], onDelete: Cascade)

  @@unique([likerId, likedUserId]) // can't like the same profile twice
  @@index([likerId])
  @@index([likedUserId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

// User.role's actual type — permission level only (USER/ADMIN/SPONSOR/
// FOUNDING_WRITER). Event and mini-challenge rewards live in UserBadge
// instead and never touch this field.
enum Role {
  USER
  ADMIN
  SPONSOR
  FOUNDING_WRITER
}

enum SprintType {
  WRITING
  READING
}

enum DraftStage {
  ROUGH      // be gentle
  POLISHING  // be honest
  FINAL_EDIT // be ruthless
}

enum SubmissionStatus {
  QUEUE      // waiting for first critique
  SPOTLIGHT  // received ≥1 critique, actively featured
  ARCHIVE    // received ≥3 critiques, closed for new feedback
}

enum WordCountTier {
  TIER_1000  // ≤1,000 words — costs/earns 1 pt
  TIER_2000  // ≤2,000 words — costs/earns 2 pts
  TIER_3000  // ≤3,000 words — costs/earns 3 pts
  TIER_4000  // ≤4,000 words — costs/earns 4 pts
  TIER_5000  // ≤5,000 words — costs/earns 5 pts
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum GoalType {
  WORDS
  CHAPTERS
  SCENES
  DURATION   // stored in minutes
}

enum DraftGoalType {
  WORDS
  CHAPTERS
  SCENES
}

// The three Bonus Quest flavors offered on off/unplanned days — see
// DraftBonusQuest. Kept small and fixed on purpose (no admin-managed pool
// like MiniChallengeTemplate) since these are meant to feel like a fun,
// low-stakes mystery-chest spin, not a configurable challenge system.
enum BonusQuestType {
  PROMPT_WRITE   // write ~400 words from a given prompt
  SANDBOX_SCENE  // draft a quick scene that doesn't need to fit the story
  FUN_FACT       // share something short, fun, and personal
}

enum BonusQuestStatus {
  CHOOSING
  ACTIVE
  DECLINED
}

enum WeekDay {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}


enum DaysChallengeDuration {
  SEVEN
  FIFTEEN
}

enum DaysChallengeGoalType {
  WORDS
  DURATION   // stored in minutes
}

enum DaysChallengeStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum DaysChallengeFocus {
  OUTLINING
  BRAINSTORMING
  EDITING
  STORY_DEVELOPMENT
}

enum StickyNoteColor {
  YELLOW
  PINK
  BLUE
  GREEN
  PURPLE
  ORANGE
}

enum BadgeSourceType {
  EVENT
  MINI_CHALLENGE
  MILESTONE   // reserved for later — not used yet
}

enum EventStatus {
  UPCOMING
  ACTIVE
  ENDED
}

enum SprintRoomNotificationKind {
  MENTION
  REPLY
}

enum MailboxCardType {
  THANK_YOU
  WELL_DONE
  CONGRATS
  WELCOME
  BIRTHDAY
  BOOSTER   // encourage/hype card for a writer who just started a new draft plan
}